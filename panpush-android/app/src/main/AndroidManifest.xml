<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      ★ 应用列表可见性（用户要求：**用户级**，第一次打开就能读应用列表）

      Android 11+ 默认把第三方包名挡住（`AppsFilter … BLOCKED`），
      导致**没有 root 时**运行日志里全是「读取不到网盘应用」——不是没装，是**看不见**。

      为什么选 QUERY_ALL_PACKAGES 而不是只靠下面的 <queries>：
       · `<queries>` 只能声明**已知**包名，而网盘 App 有「多渠道 / 改名 / 大小写」等变体
         （夸克 com.quark.*、UC com.UCMobile 大写、123 可能 com.p123.*），
         声明不全就命中不了，扫出来还是「无」。
       · `QUERY_ALL_PACKAGES` 是**安装即生效的普通权限**（无运行时弹窗），
         一次声明就能枚举全部已装应用 —— 这正是「用户级」的要求。
       ⚠️ 代价：上架 Google Play 需说明用途（本应用是网盘工具，用途正当）。
         若只为国内分发（APK 直装 / 第三方商店）则没有此限制。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      ★ 包可见性（Android 11+ / targetSdk 30+）
      真机证据：logcat 里
        `AppsFilter: interaction: com.panpush.app -> com.gopeed.gopeed BLOCKED`
      → 不声明 <queries> 时 `getLaunchIntentForPackage("com.gopeed.gopeed")` 返回 **null**，
        「拉起 Gopeed」只能靠 root 兜底，普通 startActivity 一定失败。
      这里按《诊断与改进建议》§7 P0-2 显式声明所需包名
      （**不用** QUERY_ALL_PACKAGES —— 上架会被审核卡）。

      注：读网盘凭据走 root 直读文件，**不依赖**包可见性；
      这份 <queries> 只是为了「查得到 / 拉得起」这些 App。
    -->
    <queries>
        <!-- 下载器：要拉起它 -->
        <package android:name="com.gopeed.gopeed" />

        <!-- 各站点 App（resolve-activity / 拉起 / 状态展示用） -->
        <package android:name="com.baidu.netdisk" />
        <package android:name="com.mfcloudcalculate.networkdisk" />
        <package android:name="com.xunlei.downloadprovider" />
        <package android:name="com.alicloud.databox" />
        <package android:name="com.quark.browser" />
        <package android:name="com.UCMobile" />
    </queries>

    <application
        android:name=".PanPushApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PanPush">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PanPush">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 支持从其它 App「分享 -> PanPush」直接收到分享链接 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          应用内 WebView 登录页（百度/夸克/123/迅雷/阿里 都走它）。
          ⚠️ 不要改成外部浏览器 / CustomTabs：那样 Cookie 会落在浏览器沙箱里，
             本 App 永远读不到（「登录存不下」的根因）。
          也不要加 cleartext 之外的放行：登录务必走 HTTPS。

          ★ `windowSoftInputMode="adjustResize"` 是**必须的**：
            阿里的登录要输账号/密码/验证码，缺了它软键盘弹出会把 WebView 顶飞、
            输入框被遮住 —— 这就是「手机 UI 页面有问题」的直接原因。
          ★ `configChanges` 补齐 screenLayout/smallestScreenSize：
            分屏/小窗/旋转时不重建 Activity（重建会丢 WebView 登录态）。
        -->
        <activity
            android:name=".webview.WebViewLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:label="登录网盘"
            android:theme="@style/Theme.PanPush" />

    </application>

</manifest>
